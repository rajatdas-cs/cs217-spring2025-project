  {
   "type": "text",
   "id": "s3_txt",
   "x": 778,
   "y": 172.5,
   "width": 364,
   "height": 18.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
