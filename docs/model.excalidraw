   "versionNonce": 11066,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "a pointwise classifier would\ncall them all negatives",
   "fontSize": 15,
   "fontFamily": 1,
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "s3",
   "originalText": "a pointwise classifier would\ncall them all negatives",
   "lineHeight": 1.25
  },
  {
   "type": "text",
   "id": "n1",
   "x": 70,
   "y": 240,
   "text": "BPR fixes this by supervising an ORDER instead of a score: for a sampled unobserved item j,",
   "fontSize": 15,
   "strokeColor": "#1e1e1e",
   "angle": 0,
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "seed": 1007,
   "version": 1,
   "versionNonce": 7049,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "BPR fixes this by supervising an ORDER instead of a score: for a sampled unobserved item j,",
   "lineHeight": 1.25,
   "width": 750.7500000000001,
   "height": 18.75
  },
  {
   "type": "text",
   "id": "n1b",
   "x": 70,
   "y": 272,
   "text": "maximise sigma(r_ui - r_uj). Only the difference is constrained, so nothing forces j to score low.",
   "fontSize": 15,
   "strokeColor": "#1e1e1e",
   "angle": 0,
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "seed": 1008,
   "version": 1,
   "versionNonce": 7056,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "maximise sigma(r_ui - r_uj). Only the difference is constrained, so nothing forces j to score low.",
   "lineHeight": 1.25,
   "width": 808.5000000000001,
   "height": 18.75
  },
